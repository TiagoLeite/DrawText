<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".AdMobClass"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:replace="android:allowBackup">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3543569662200404~7307834597"/>
        <activity android:name=".LetterConsonantActivity" android:configChanges="orientation"
            android:exported="false" />
        <activity android:name=".LetterConsonantMainActivity" android:configChanges="orientation"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".NumberActivity"
            android:configChanges="orientation"
            android:theme="@style/AppTheme"
            android:exported="false"/>
        <activity
            android:name=".NumberMainActivity"
            android:configChanges="orientation"
            android:theme="@style/AppTheme"
            android:exported="false"/>
        <activity
            android:name=".LetterVowelMainActivity"
            android:configChanges="orientation"
            android:theme="@style/AppTheme"
            android:exported="false"/>
        <activity
            android:name=".LetterVowelActivity"
            android:configChanges="orientation"
            android:theme="@style/AppTheme"
            android:exported="false"/>
        <activity
            android:name=".LetterActivity"
            android:configChanges="orientation"
            android:theme="@style/AppTheme"
            android:exported="false"/>

    </application>

</manifest>